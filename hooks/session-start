#!/usr/bin/env bash
# SessionStart hook for opinionated-prisma plugin

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_content=$(cat "${PLUGIN_ROOT}/skills/opinionated-prisma/SKILL.md" 2>&1 || echo "Error reading opinionated-prisma skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

skill_escaped=$(escape_for_json "$skill_content")
session_context="The opinionated-prisma plugin is installed. When working with Prisma ORM or PostgreSQL (schema design, queries, migrations, indexing, transactions, raw SQL), use the 'opinionated-prisma' skill via the Skill tool for opinionated patterns and best practices.\\n\\nTrigger keywords: prisma, schema, migrate, index, query, \$queryRaw, transaction, bulk, database, model, relation."

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
